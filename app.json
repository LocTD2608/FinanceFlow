{
  "expo": {
    "name": "FinanceFlow",
    "slug": "btl-finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.btl.financeflow"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép FinanceFlow truy cập Camera để quét mã QR thanh toán."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép FinanceFlow sử dụng Face ID để xác thực chuyển tiền nhanh chóng."
        }
      ]
    ]
  }
}
