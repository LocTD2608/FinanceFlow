# Cổng máy chủ API backend
PORT=5000

# Chuỗi kết nối MongoDB (Local hoặc MongoDB Atlas Cloud)
# Ví dụ Local: mongodb://localhost:27017/financeflow_dev
# Ví dụ Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/financeflow_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/financeflow_dev

# Khóa bí mật ký mã token JWT
JWT_SECRET=financeflow_dev_jwt_secret_2026

# Gửi email OTP qua Gmail (bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" 16 ký tự)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="FinanceFlow <your_account@gmail.com>"

# (Tùy chọn) Expo Push access token nếu bật "Enhanced Push Security"
EXPO_ACCESS_TOKEN=

# Bật/tắt các cron job (mặc định bật). Đặt false để tắt khi chạy nhiều instance.
ENABLE_CRON=true
